{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://pkb-bak.kmchat.cloud:8010/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Forwarded-Proto",
          "value": "http"
        }
      ]
    }
  ]
}
